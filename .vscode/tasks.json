{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/MSPASalon.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build-tests",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/tests/MSPASalon.Tests/MSPASalon.Tests.csproj", "/property:GenerateFullPaths=true"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": ["run", "--project", "${workspaceFolder}/tests/MSPASalon.Tests/MSPASalon.Tests.csproj"],
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "run",
            "command": "dotnet",
            "type": "process",
            "args": ["run", "--project", "${workspaceFolder}/src/MSPASalon.Desktop/MSPASalon.Desktop.csproj"],
            "problemMatcher": "$msCompile"
        }
    ]
}
