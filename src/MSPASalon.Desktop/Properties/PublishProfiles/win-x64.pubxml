<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for the cashier PC (decisions: framework-dependent, per-machine installer, POSSalon.exe).
    dotnet publish src/MSPASalon.Desktop -p:PublishProfile=win-x64
  Output: publish/win-x64/POSSalon.exe (single file). The PC needs the .NET 10 Desktop Runtime (x64);
  the installer checks it. Do NOT enable PublishTrimmed: WPF does not support trimming.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- e_sqlite3.dll (SQLite engine) is native: bundle it inside the single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
