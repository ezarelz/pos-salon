<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark palette: same keys as Palette.Light.xaml. Text/background pairs keep a contrast ratio of at least 4.5:1.
        The accent is lighter than in light mode, so primary buttons use dark text (OnAccentBrush) instead of white.
    -->
    <Color x:Key="AccentColor">#D08BB6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#D08BB6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#DCA2C6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B9729E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2836" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1220" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16131A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#221E27" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#100D13" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2A2430" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#E9E4EE" />
    <SolidColorBrush x:Key="NavTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavMutedBrush" Color="#8E8698" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECE7F1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A69EB0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3442" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F28B82" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B2020" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6DCB94" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1C3326" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8B54A" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A3020" />
    <SolidColorBrush x:Key="InfoBrush" Color="#8AB4F8" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1F2A3D" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#26222B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2E2834" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#4A3045" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4352" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6E6578" />

    <!--
        System colours used by the built-in WPF control templates (TextBox, CheckBox, popups, tooltips, ...).
        Overriding them here makes controls without a custom template follow the dark palette too.
        They exist only in the dark palette: in light mode the Windows defaults apply.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#221E27" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECE7F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#221E27" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECE7F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8E8698" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4A3045" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ECE7F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A2836" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ECE7F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2E2834" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#ECE7F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#221E27" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#ECE7F1" />
</ResourceDictionary>
