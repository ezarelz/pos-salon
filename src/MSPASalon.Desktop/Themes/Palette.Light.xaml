<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Light palette. Palette.Dark.xaml MUST define exactly the same keys.
        ThemeService swaps this dictionary at runtime, so every view references these brushes with
        {DynamicResource ...} (never StaticResource), otherwise that element would not follow the theme switch.
    -->
    <Color x:Key="AccentColor">#8E3B6F</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#8E3B6F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A3497F" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#732E59" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F6EAF1" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F4F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#2B2433" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#3D3446" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#E9E4EE" />
    <SolidColorBrush x:Key="NavTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavMutedBrush" Color="#9C93A6" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F1A24" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B6472" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DAD5DF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBE9E8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7A46" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E5F3EA" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF6DD" />
    <SolidColorBrush x:Key="InfoBrush" Color="#2F5DA8" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#E7EEFB" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#FAF8FB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F3EEF5" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#EBD7E4" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9C2D0" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9C93A6" />
</ResourceDictionary>
