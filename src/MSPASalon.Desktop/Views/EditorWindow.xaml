<Window x:Class="MSPASalon.Desktop.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MSPASalon.Desktop.Converters"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <!--
        Generic modal editor host. Responsive structure (same for every editor):
          Row 0  title                          (Auto)
          Row 1  form content in a ScrollViewer (*)    → scrolls when the window is short
          Row 2  footer: error text + buttons   (Auto) → ALWAYS visible, never scrolled away
        The concrete form is chosen by the implicit DataTemplate for the editor ViewModel type
        (Views/Editors/EditorTemplates.xaml).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="17" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="20,16">
            <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ErrorBox}" Margin="0,0,12,0" VerticalAlignment="Center"
                        Visibility="{Binding HasError, Converter={x:Static conv:Conv.BoolToVisibility}}">
                    <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" MinWidth="110" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
