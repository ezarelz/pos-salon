<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MSPASalon.Desktop.Converters"
                    xmlns:ed="clr-namespace:MSPASalon.Presentation.ViewModels.Editors;assembly=MSPASalon.Presentation"
                    xmlns:c="clr-namespace:MSPASalon.Desktop.Controls"
                    xmlns:tx="clr-namespace:MSPASalon.Presentation.ViewModels.Transactions;assembly=MSPASalon.Presentation">
    <!--
        One implicit DataTemplate per editor ViewModel. Every form uses c:FormPanel, which shows two
        columns on wide dialogs and one column on narrow ones. All text inputs use
        UpdateSourceTrigger=PropertyChanged so pressing Enter (default button) saves the latest value.
        A trailing '*' in a label marks a required field.
    -->

    <!-- ================================================================== Customer -->
    <DataTemplate DataType="{x:Type ed:CustomerEditorViewModel}">
        <c:FormPanel>
            <StackPanel>
                <TextBlock Text="Kode *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Nama *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="No. HP" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Jenis Kelamin" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Genders}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Gender}" />
            </StackPanel>
            <StackPanel c:FormPanel.IsFullRow="True">
                <TextBlock Text="Alamat" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" />
            </StackPanel>
            <StackPanel c:FormPanel.IsFullRow="True">
                <TextBlock Text="Catatan" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" />
            </StackPanel>
            <WrapPanel c:FormPanel.IsFullRow="True">
                <CheckBox Content="Member" IsChecked="{Binding IsMember}" />
                <CheckBox Content="Customer Walk-in (default penjualan)" IsChecked="{Binding IsWalkIn}" />
                <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" />
            </WrapPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Supplier -->
    <DataTemplate DataType="{x:Type ed:SupplierEditorViewModel}">
        <c:FormPanel>
            <StackPanel>
                <TextBlock Text="Kode *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Nama *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Kontak Person" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="No. Telp" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" />
            </StackPanel>
            <StackPanel c:FormPanel.IsFullRow="True">
                <TextBlock Text="Alamat" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" />
            </StackPanel>
            <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" c:FormPanel.IsFullRow="True" />
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Category -->
    <DataTemplate DataType="{x:Type ed:CategoryEditorViewModel}">
        <c:FormPanel>
            <StackPanel>
                <TextBlock Text="Kode *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Nama Kategori *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </StackPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Employee -->
    <DataTemplate DataType="{x:Type ed:EmployeeEditorViewModel}">
        <c:FormPanel>
            <StackPanel>
                <TextBlock Text="Kode *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Nama *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Jabatan" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Jenis Kelamin" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Genders}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Gender}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="No. Telp" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" />
            </StackPanel>
            <StackPanel c:FormPanel.IsFullRow="True">
                <TextBlock Text="Alamat" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" />
            </StackPanel>
            <StackPanel c:FormPanel.IsFullRow="True">
                <WrapPanel>
                    <CheckBox Content="Capster / Terapis (bisa ditugaskan ke jasa)" IsChecked="{Binding IsCapster}" />
                    <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource HintText}" Text="Gaji pokok tidak disimpan di aplikasi ini." />
            </StackPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Payment method -->
    <DataTemplate DataType="{x:Type ed:PaymentMethodEditorViewModel}">
        <c:FormPanel>
            <StackPanel>
                <TextBlock Text="Kode *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Nama *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Urutan tampil" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
            </StackPanel>
            <StackPanel c:FormPanel.IsFullRow="True">
                <WrapPanel>
                    <CheckBox Content="Tunai (hitung kembalian)" IsChecked="{Binding IsCash}" />
                    <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource HintText}"
                           Text="Metode bayar hanya untuk pencatatan. Non-tunai (QRIS/Transfer) dicatat sebesar total tagihan; nomor referensi opsional." />
            </StackPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Product -->
    <DataTemplate DataType="{x:Type ed:ProductEditorViewModel}">
        <c:FormPanel>
            <StackPanel>
                <TextBlock Text="Kode *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Nama Produk *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Kategori" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding CategoryId}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Satuan stok * (mis. BTL, PCS, BOX)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Harga Pokok (Rp) *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Harga Jual (Rp) *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SellPriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Stok Minimum" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StockMinText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Stok Maksimum (0 = tidak dibatasi)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StockMaxText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Isi per satuan (opsional, info)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ContentQtyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Satuan isi (mis. ml, gr)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ContentUnit, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Stok saat ini (dari kartu stok)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StockOnHandText, Mode=OneWay}" IsReadOnly="True" Focusable="False" />
            </StackPanel>
            <StackPanel c:FormPanel.IsFullRow="True">
                <WrapPanel>
                    <CheckBox Content="Dijual (penjualan produk)" IsChecked="{Binding IsSellable}" />
                    <CheckBox Content="Bahan habis pakai (resep jasa / backflush)" IsChecked="{Binding IsConsumable}" />
                    <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource HintText}"
                           Text="Stok tidak bisa diubah di sini. Stok hanya berubah melalui transaksi (pembelian, penjualan, treatment, adjustment) agar selalu bisa direkonsiliasi." />
            </StackPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Service + recipe -->
    <DataTemplate DataType="{x:Type ed:ServiceEditorViewModel}">
        <StackPanel>
            <c:FormPanel>
                <StackPanel>
                    <TextBlock Text="Kode *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Nama Jasa *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Harga Jasa (Rp) *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Komisi Capster (Rp per jasa) *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CommissionText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
                </StackPanel>
                <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" c:FormPanel.IsFullRow="True" />
            </c:FormPanel>

            <TextBlock Text="Resep Bahan (pemakaian per 1 customer)" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                       Text="Saat proses treatment diposting, stok bahan dikurangi otomatis (backflush) sesuai resep ini. Qty dalam satuan stok produk, mis. 0,1 BTL." />

            <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,8"
                    Visibility="{Binding HasConsumables, Converter={x:Static conv:Conv.InverseBoolToVisibility}}">
                <TextBlock TextWrapping="Wrap"
                           Text="Belum ada produk yang ditandai 'Bahan habis pakai'. Tandai dulu di Master Produk." />
            </Border>

            <!-- add-line bar: wraps onto two lines on narrow dialogs -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding ConsumableProducts}" DisplayMemberPath="Name"
                          SelectedItem="{Binding ProductToAdd}" IsEditable="False" Margin="0,0,8,0"
                          ToolTip="Pilih bahan habis pakai" />
                <TextBox Grid.Column="1" Width="90" Text="{Binding QtyToAdd, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NumberTextBox}" Margin="0,0,8,0" ToolTip="Qty pemakaian, mis. 0,1" />
                <Button Grid.Column="2" Content="Tambah Bahan" Command="{Binding AddMaterialCommand}" />
            </Grid>

            <DataGrid ItemsSource="{Binding Materials}" MinHeight="96" MaxHeight="260" IsReadOnly="False"
                      CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bahan" Binding="{Binding ProductLabel, Mode=OneWay}" Width="*" MinWidth="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="Qty" Width="80"
                                        Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Satuan" Binding="{Binding Unit, Mode=OneWay}" Width="Auto" MinWidth="60" IsReadOnly="True" />
                    <DataGridTextColumn Header="Ekuivalen" Binding="{Binding EquivalentText, Mode=OneWay}" Width="Auto" MinWidth="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="Biaya (Rp)" Binding="{Binding CostText, Mode=OneWay}" Width="Auto" MinWidth="90"
                                        IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Hapus bahan"
                                        Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" MinHeight="26" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- standard unit economics per customer -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,8">
                <WrapPanel>
                    <TextBlock Margin="0,2,24,2"><Run Text="Biaya bahan standar: Rp " /><Run Text="{Binding MaterialCostText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock Margin="0,2,0,2"><Run Text="Margin per customer (harga − komisi − bahan): Rp " /><Run Text="{Binding MarginText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                </WrapPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ================================================================== Role -->
    <DataTemplate DataType="{x:Type ed:RoleEditorViewModel}">
        <StackPanel>
            <c:FormPanel>
                <StackPanel>
                    <TextBlock Text="Kode Role *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper"
                             IsEnabled="{Binding IsCodeEditable}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Nama Role *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                </StackPanel>
            </c:FormPanel>
            <TextBlock Text="Hak Akses" Style="{StaticResource SectionTitle}" Margin="0,16,0,2" />
            <TextBlock Text="{Binding Hint}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding PermissionGroups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Module}" FontWeight="SemiBold" Margin="0,4,0,2" />
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEditable}"
                                                  Width="250" ToolTip="{Binding Code}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- ================================================================== User -->
    <DataTemplate DataType="{x:Type ed:UserEditorViewModel}">
        <c:FormPanel>
            <StackPanel>
                <TextBlock Text="Username *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Nama Tampilan *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Role *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RoleId}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Karyawan" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EmployeeId}" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsNew, Converter={x:Static conv:Conv.BoolToVisibility}}">
                <TextBlock Text="Password * (min. 6 karakter)" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsNew, Converter={x:Static conv:Conv.BoolToVisibility}}">
                <TextBlock Text="Ulangi Password *" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
            </StackPanel>
            <WrapPanel c:FormPanel.IsFullRow="True">
                <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" />
                <CheckBox Content="Wajib ganti password saat login berikutnya" IsChecked="{Binding MustChangePassword}" />
            </WrapPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Reset password -->
    <DataTemplate DataType="{x:Type ed:ResetPasswordEditorViewModel}">
        <c:FormPanel>
            <TextBlock Text="{Binding Info}" Style="{StaticResource HintText}" c:FormPanel.IsFullRow="True" />
            <StackPanel>
                <TextBlock Text="Password Baru *" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Ulangi Password Baru *" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
            </StackPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== Change own password -->
    <DataTemplate DataType="{x:Type ed:ChangePasswordViewModel}">
        <c:FormPanel MaxColumns="1">
            <TextBlock Text="{Binding Info}" Style="{StaticResource HintText}" />
            <StackPanel>
                <TextBlock Text="Password Lama *" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding CurrentPassword, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Password Baru *" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Ulangi Password Baru *" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
            </StackPanel>
        </c:FormPanel>
    </DataTemplate>

    <!-- ================================================================== M2/M3: shared payment panel -->
    <DataTemplate DataType="{x:Type tx:PaymentViewModel}">
        <Border Style="{StaticResource Card}" Padding="14,10">
            <c:FormPanel ColumnMinWidth="220" MaxColumns="3">
                <StackPanel>
                    <TextBlock Text="Metode Bayar *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MethodId}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsCash, Converter={x:Static conv:Conv.BoolToVisibility}}">
                    <TextBlock Text="Uang Diterima (Rp) *" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
                        <Button Grid.Column="1" Content="Uang Pas" Command="{Binding ExactCommand}" Margin="6,0,0,0" MinWidth="0" Padding="8,4" />
                    </Grid>
                </StackPanel>
                <StackPanel Visibility="{Binding IsNonCash, Converter={x:Static conv:Conv.BoolToVisibility}}">
                    <TextBlock Text="No. Referensi (opsional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                </StackPanel>
                <StackPanel c:FormPanel.IsFullRow="True">
                    <TextBlock Style="{StaticResource TotalText}"><Run Text="Total tagihan: Rp " /><Run Text="{Binding AmountDueText, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding ChangeText}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShort}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </c:FormPanel>
        </Border>
    </DataTemplate>

    <!-- one service + capster row (registration editor and treatment page) -->
    <DataTemplate x:Key="ServiceLineRow">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="140" />
                <ColumnDefinition Width="2*" MinWidth="120" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Services}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding ServiceId}" Margin="0,0,6,0" ToolTip="Jasa" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Capsters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding EmployeeId}" Margin="0,0,6,0" ToolTip="Capster" />
            <TextBlock Grid.Column="2" Text="{Binding PriceText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Hapus baris"
                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" />
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Registration -->
    <DataTemplate DataType="{x:Type tx:RegistrationEditorViewModel}">
        <StackPanel>
            <c:FormPanel>
                <StackPanel>
                    <TextBlock Text="Customer *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding CustomerId}" IsTextSearchEnabled="True" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Catatan (mis. rambut panjang)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                </StackPanel>
            </c:FormPanel>
            <Border Style="{StaticResource ErrorBox}" Margin="0,10,0,0"
                    Visibility="{Binding HasNoCapster, Converter={x:Static conv:Conv.BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Text="Belum ada karyawan aktif yang ditandai Capster. Tandai di Master Karyawan." />
            </Border>
            <TextBlock Text="Jasa &amp; Capster" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="140" />
                    <ColumnDefinition Width="2*" MinWidth="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Jasa" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Capster" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="Harga" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" Margin="0,0,6,4" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource ServiceLineRow}" Focusable="False" />
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Left" Content="+ Tambah Jasa" Command="{Binding AddLineCommand}" />
                <TextBlock Style="{StaticResource TotalText}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="Total Rp " /><Run Text="{Binding TotalText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                       Text="Pembayaran dilakukan di layar Proses Treatment setelah jasa selesai dikerjakan." />
        </StackPanel>
    </DataTemplate>

    <!-- shared "pick product + qty + Tambah" bar -->
    <DataTemplate x:Key="ProductPickerBar">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Picker.Products}" DisplayMemberPath="Name"
                      SelectedItem="{Binding Picker.Product}" Margin="0,0,8,0" ToolTip="Pilih produk" IsTextSearchEnabled="True" />
            <TextBox Grid.Column="1" Width="80" Text="{Binding Picker.QtyText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource NumberTextBox}" Margin="0,0,8,0" ToolTip="Qty (desimal pakai koma, mis. 0,5)" />
            <Button Grid.Column="2" Content="Tambah" Command="{Binding AddLineCommand}" />
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Sale -->
    <DataTemplate DataType="{x:Type tx:SaleEditorViewModel}">
        <StackPanel>
            <c:FormPanel>
                <StackPanel>
                    <TextBlock Text="Customer *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding CustomerId}" IsTextSearchEnabled="True" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Catatan" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                </StackPanel>
            </c:FormPanel>
            <TextBlock Text="Produk" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProductPickerBar}" Focusable="False" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Produk" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Stok" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="Qty" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="3" Text="Harga" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="4" Text="Diskon" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="5" Text="Total" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProductLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding StockText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBox Grid.Column="2" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="3" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="4" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="5" Text="{Binding TotalText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Hapus baris"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel HorizontalAlignment="Right" Margin="0,6,0,12">
                <TextBlock Margin="0,0,20,0"><Run Text="Subtotal Rp " /><Run Text="{Binding SubtotalText, Mode=OneWay}" /></TextBlock>
                <TextBlock><Run Text="Diskon Rp " /><Run Text="{Binding DiscountTotalText, Mode=OneWay}" /></TextBlock>
            </WrapPanel>
            <ContentControl Content="{Binding Payment}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ================================================================== Purchase -->
    <DataTemplate DataType="{x:Type tx:PurchaseEditorViewModel}">
        <StackPanel>
            <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,10"
                    Visibility="{Binding HasNoSupplier, Converter={x:Static conv:Conv.BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Text="Belum ada supplier aktif. Tambahkan dulu di Master Supplier." />
            </Border>
            <c:FormPanel>
                <StackPanel>
                    <TextBlock Text="Supplier *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SupplierId}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="No. Nota / Faktur Supplier" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SupplierRef, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                </StackPanel>
                <StackPanel c:FormPanel.IsFullRow="True">
                    <TextBlock Text="Catatan" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                </StackPanel>
            </c:FormPanel>
            <TextBlock Text="Barang Diterima" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProductPickerBar}" Focusable="False" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Produk" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Qty" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="Harga Beli" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="3" Text="Total" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProductLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="3" Text="{Binding TotalText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Hapus baris"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource TotalText}" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Run Text="Total Rp " /><Run Text="{Binding TotalText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                       Text="Harga beli dicatat di kartu stok. Harga pokok di Master Produk tidak berubah otomatis." />
        </StackPanel>
    </DataTemplate>

    <!-- ================================================================== Adjustment -->
    <DataTemplate DataType="{x:Type tx:AdjustmentEditorViewModel}">
        <StackPanel>
            <TextBlock Text="Alasan * (mis. Stock opname Oktober, barang rusak)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
            <TextBlock Text="Produk" Style="{StaticResource SectionTitle}" Margin="0,16,0,2" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="Qty positif menambah stok, negatif mengurangi (mis. -0,35)." />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProductPickerBar}" Focusable="False" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Produk" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Stok Kini" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="Qty (+/−)" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="3" Text="Sesudah" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="4" Text="Nilai (HPP)" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProductLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding StockText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBox Grid.Column="2" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="3" Text="{Binding AfterText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding CostValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Hapus baris"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource TotalText}" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Run Text="Nilai adjustment Rp " /><Run Text="{Binding TotalValueText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- ================================================================== Cancel reason -->
    <DataTemplate DataType="{x:Type tx:CancelReasonEditorViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Info}" Style="{StaticResource HintText}" Margin="0,0,0,10" />
            <TextBlock Text="Alasan pembatalan *" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" MaxLength="200" />
        </StackPanel>
    </DataTemplate>

    <!-- ================================================================== Document / receipt view -->
    <DataTemplate DataType="{x:Type tx:DocumentDetailViewModel}">
        <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource MonoText}" MinHeight="300" />
    </DataTemplate>
</ResourceDictionary>
