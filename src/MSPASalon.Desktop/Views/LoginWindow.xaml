<Window x:Class="MSPASalon.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MSPASalon.Desktop.Converters"
        xmlns:c="clr-namespace:MSPASalon.Desktop.Controls"
        Title="Login — POS Salon"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- Small fixed dialog (≈ 400×390 DIP) that fits the smallest target work area (853×440). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Style="{StaticResource Card}" Margin="16" Padding="24,20">
            <StackPanel>
                <TextBlock Text="{Binding SalonName}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                <TextBlock Text="Masuk untuk melanjutkan" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,18" />

                <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay}" Margin="0,0,0,12" />

                <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={x:Static conv:Conv.BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                </Border>

                <Button Content="Masuk" Command="{Binding LoginCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" MinHeight="36" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                           Text="Login pertama: admin / admin (Anda akan diminta mengganti password)." />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
