<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MSPASalon.Desktop.Converters"
                    xmlns:v="clr-namespace:MSPASalon.Desktop.Views"
                    xmlns:c="clr-namespace:MSPASalon.Desktop.Controls"
                    xmlns:tx="clr-namespace:MSPASalon.Presentation.ViewModels.Transactions;assembly=MSPASalon.Presentation">

    <!-- ================================================================== master list -->
    <DataTemplate x:Key="ListPageTemplate">
        <v:MasterListView />
    </DataTemplate>

    <!-- ================================================================== dashboard -->
    <DataTemplate x:Key="DashboardTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16">
                <!-- header: greeting · date · quick actions -->
                <DockPanel Margin="0,0,0,14">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ItemsControl ItemsSource="{Binding QuickLinks}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,6" ToolTip="{Binding Title}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}"
                                ToolTip="Muat ulang data hari ini" Margin="0,0,0,6" />
                    </WrapPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SalonName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding UpdatedText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- KPI cards (today): 4 → 2 → 1 per row depending on width -->
                <c:FormPanel ColumnMinWidth="200" MaxColumns="4" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiIcon}" Background="{DynamicResource SuccessSoftBrush}">
                                <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Pendapatan hari ini" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding RevenueText}" Style="{StaticResource KpiValue}" ToolTip="{Binding RevenueText}" />
                                <TextBlock Text="{Binding RevenueDetailText}" Style="{StaticResource HintText}" />
                                <TextBlock Text="{Binding PreviousDayText}" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiIcon}" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Client selesai" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding ClientsText}" Style="{StaticResource KpiValue}" />
                                <TextBlock Text="{Binding ClientsDetailText}" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiIcon}" Background="{DynamicResource WarningSoftBrush}">
                                <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Antrian saat ini" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding QueueText}" Style="{StaticResource KpiValue}" />
                                <TextBlock Text="{Binding QueueDetailText}" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiIcon}" Background="{DynamicResource InfoSoftBrush}">
                                <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource InfoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Transaksi hari ini" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding TransactionsText}" Style="{StaticResource KpiValue}" />
                                <TextBlock Text="{Binding TransactionsDetailText}" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </c:FormPanel>

                <!-- latest transactions (wide) · payment recap -->
                <c:FormPanel ColumnMinWidth="340" MaxColumns="2" ColumnSpacing="12" RowSpacing="12" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Transaksi terakhir hari ini" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Belum ada transaksi hari ini." Foreground="{DynamicResource MutedTextBrush}"
                                       Visibility="{Binding Recent.Count, Converter={x:Static conv:Conv.ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DocNo, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding MethodName}" Style="{StaticResource HintText}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Rekap pembayaran hari ini" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Belum ada pembayaran." Foreground="{DynamicResource MutedTextBrush}"
                                       Visibility="{Binding Methods.Count, Converter={x:Static conv:Conv.ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Methods}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AmountText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,8,0,0"
                                    Visibility="{Binding Methods, Converter={x:Static conv:Conv.HasValueToVisibility}}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding MethodsTotalText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Total" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0">
                                        <Run Text="Uang tunai yang seharusnya ada di laci: " /><Run Text="{Binding CashText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- capster work · low stock -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Kinerja karyawan hari ini" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Belum ada treatment selesai." Foreground="{DynamicResource MutedTextBrush}"
                                       Visibility="{Binding Capsters.Count, Converter={x:Static conv:Conv.ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Capsters}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WorkText}" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AmountText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Visibility="{Binding Capsters, Converter={x:Static conv:Conv.HasValueToVisibility}}"
                                       Text="Nilai jasa sebelum diskon nota." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Stok di bawah minimum" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Semua stok aman." Foreground="{DynamicResource SuccessBrush}"
                                       Visibility="{Binding LowStockLines.Count, Converter={x:Static conv:Conv.ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding LowStockLines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource DangerBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </c:FormPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================================================================== branch settings -->
    <DataTemplate x:Key="BranchTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="20,16" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Pengaturan Salon" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
                    <c:FormPanel>
                        <StackPanel>
                            <TextBlock Text="Nama Salon *" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Nama Singkat" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="No. Telp" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Printer Nota" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding PaperWidths}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding PaperWidthMm}" />
                        </StackPanel>
                        <StackPanel c:FormPanel.IsFullRow="True">
                            <TextBlock Text="Alamat (tercetak di nota)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" />
                        </StackPanel>
                        <StackPanel c:FormPanel.IsFullRow="True">
                            <TextBlock Text="Logo nota (dicetak di tengah, di atas nama salon)" Style="{StaticResource FieldLabel}" />
                            <WrapPanel>
                                <!-- preview on white, like the paper, in both themes -->
                                <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                        Width="200" Height="110" Padding="8" Margin="0,0,12,6">
                                    <Grid>
                                        <Image Source="{Binding Logo, Converter={x:Static conv:Conv.ImageBytes}}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="Belum ada logo" Foreground="#6B6472" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasLogo, Converter={x:Static conv:Conv.InverseBoolToVisibility}}" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <Button Content="Pilih Logo…" Command="{Binding ChooseLogoCommand}" Margin="0,0,0,6" HorizontalAlignment="Left" />
                                    <Button Content="Hapus Logo" Command="{Binding RemoveLogoCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource HintText}" MaxWidth="320" Margin="0,8,0,0"
                                               Text="PNG/JPG/BMP, maks. 1 MB. Logo hitam-putih berlatar putih paling jelas di printer thermal." />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel c:FormPanel.IsFullRow="True">
                            <TextBlock Text="Catatan kaki nota (mis. 'Terima kasih atas kunjungan Anda')" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineTextBox}" />
                        </StackPanel>
                    </c:FormPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="20,10">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Simpan" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== coming soon -->
    <DataTemplate x:Key="ComingSoonTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Border Style="{StaticResource Card}" Margin="20" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,6,0,10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">
                        <Run Text="Dijadwalkan pada milestone " /><Run Text="{Binding Milestone, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DataTemplate>


    <!-- ================================================================== treatment processing (M2) -->
    <!--
        Two columns: queue (fixed 260 DIP) | selected registration/treatment (*).
        The right side follows the editor pattern: header (Auto) · scrollable content (*) · action footer (Auto, always visible).
    -->
    <DataTemplate x:Key="TreatmentTemplate">
        <Grid Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- queue -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="12,10,6,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Muat ulang antrian" />
                        <StackPanel>
                            <TextBlock Text="Antrian" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="{Binding QueueText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedRegistration}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding RegNo}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ServiceSummary}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="16,12,16,8">
                        <TextBlock Text="{Binding HeaderText}" Style="{StaticResource PageTitle}" FontSize="17" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NotesText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding NotesText, Converter={x:Static conv:Conv.HasValueToVisibility}}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="16,0,16,8">
                        <StackPanel>
                            <!-- waiting: registration summary -->
                            <StackPanel Visibility="{Binding IsWaiting, Converter={x:Static conv:Conv.BoolToVisibility}}">
                                <TextBlock Text="Jasa yang didaftarkan" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SelectedRegistration.ServiceSummary}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"><Run Text="Total Rp " /><Run Text="{Binding SubtotalText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="Tekan 'Mulai Treatment' saat customer mulai dikerjakan. Jam mulai tercatat otomatis." />
                            </StackPanel>

                            <!-- in process: editable services -->
                            <StackPanel Visibility="{Binding IsInProcess, Converter={x:Static conv:Conv.BoolToVisibility}}">
                                <TextBlock Text="Jasa &amp; Capster" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource ServiceLineRow}" Focusable="False" />
                                <WrapPanel Margin="0,2,0,0">
                                    <Button Content="+ Tambah Jasa" Command="{Binding AddLineCommand}" Margin="0,0,8,6" />
                                    <Button Content="Simpan Perubahan Jasa" Command="{Binding SaveLinesCommand}" Margin="0,0,8,6" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- backflush preview -->
                            <StackPanel Visibility="{Binding HasBackflush, Converter={x:Static conv:Conv.BoolToVisibility}}" Margin="0,10,0,0">
                                <TextBlock Text="Bahan yang akan dipakai (backflush)" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding Backflush}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ProductName, Mode=OneWay}" /><Run Text="  −" /><Run Text="{Binding Qty, Mode=OneWay, Converter={x:Static conv:Conv.Qty}}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="stok " /><Run Text="{Binding StockOnHand, Mode=OneWay, Converter={x:Static conv:Conv.Qty}}" /><Run Text=" → " /><Run Text="{Binding StockAfter, Mode=OneWay, Converter={x:Static conv:Conv.Qty}}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding HasShortage, Converter={x:Static conv:Conv.BoolToVisibility}}"
                                           Text="Stok sebagian bahan tidak cukup. Treatment tetap bisa diselesaikan; stok akan minus dan perlu dikoreksi." />
                            </StackPanel>

                            <!-- totals and payment -->
                            <StackPanel Visibility="{Binding IsInProcess, Converter={x:Static conv:Conv.BoolToVisibility}}" Margin="0,12,0,0">
                                <c:FormPanel ColumnMinWidth="180" MaxColumns="3">
                                    <StackPanel>
                                        <TextBlock Text="Subtotal (Rp)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SubtotalText, Mode=OneWay}" IsReadOnly="True" Focusable="False" Style="{StaticResource NumberTextBox}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Diskon (Rp)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberTextBox}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Total (Rp)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TotalText, Mode=OneWay}" IsReadOnly="True" Focusable="False" Style="{StaticResource NumberTextBox}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </c:FormPanel>
                                <ContentControl Content="{Binding Payment}" Margin="0,10,0,0" Focusable="False" />
                            </StackPanel>

                            <TextBlock Text="Pilih registrasi dari antrian di sebelah kiri." Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,0"
                                       Visibility="{Binding HasSelection, Converter={x:Static conv:Conv.InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- actions: always visible -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Batalkan" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                    Visibility="{Binding HasSelection, Converter={x:Static conv:Conv.BoolToVisibility}}" />
                            <Button Content="Mulai Treatment" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" MinWidth="140"
                                    Visibility="{Binding IsWaiting, Converter={x:Static conv:Conv.BoolToVisibility}}" />
                            <Button Content="Selesai &amp; Bayar" Command="{Binding CompleteCommand}" Style="{StaticResource PrimaryButton}" MinWidth="140"
                                    Visibility="{Binding IsInProcess, Converter={x:Static conv:Conv.BoolToVisibility}}" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== stock card (M3) -->
    <DataTemplate x:Key="StockCardTemplate">
        <Grid Margin="16,12,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ProductId}"
                          Width="320" Margin="0,0,12,6" IsTextSearchEnabled="True" ToolTip="Pilih produk" />
                <TextBlock Text="Tanggal" VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{DynamicResource MutedTextBrush}" />
                <DatePicker SelectedDate="{Binding DateFrom}" Width="130" Margin="0,0,0,6" />
                <TextBlock Text="s/d" VerticalAlignment="Center" Margin="6,0,6,6" Foreground="{DynamicResource MutedTextBrush}" />
                <DatePicker SelectedDate="{Binding DateTo}" Width="130" Margin="0,0,8,6" />
                <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Muat ulang" Margin="0,0,0,6" />
            </WrapPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Margin="0,0,24,4"><Run Text="Saldo awal: " /><Run Text="{Binding OpeningText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                <TextBlock Margin="0,0,24,4"><Run Text="Masuk: " /><Run Text="{Binding InText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                <TextBlock Margin="0,0,24,4"><Run Text="Keluar: " /><Run Text="{Binding OutText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                <TextBlock Margin="0,0,24,4"><Run Text="Saldo akhir: " /><Run Text="{Binding ClosingText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            </WrapPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding MovedAt, Converter={x:Static conv:Conv.DateTimeText}}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="No. Dokumen" Binding="{Binding DocNo}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="Jenis" Binding="{Binding SourceLabel}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="Masuk" Binding="{Binding QtyIn, Converter={x:Static conv:Conv.Qty}}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Keluar" Binding="{Binding QtyOut, Converter={x:Static conv:Conv.Qty}}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, Converter={x:Static conv:Conv.Qty}}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Keterangan" Binding="{Binding Notes}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <v:PageTemplateSelector x:Key="PageSelector"
                            ListTemplate="{StaticResource ListPageTemplate}"
                            DashboardTemplate="{StaticResource DashboardTemplate}"
                            BranchTemplate="{StaticResource BranchTemplate}"
                            ComingSoonTemplate="{StaticResource ComingSoonTemplate}"
                            TreatmentTemplate="{StaticResource TreatmentTemplate}"
                            StockCardTemplate="{StaticResource StockCardTemplate}" />
</ResourceDictionary>
