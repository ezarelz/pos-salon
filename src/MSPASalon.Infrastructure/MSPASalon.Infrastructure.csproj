<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQLite persistence (Dapper), migrations, document numbering, backup and legacy import. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MSPASalon.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MSPASalon.Core\MSPASalon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migration scripts are compiled into the assembly so the database can always be created/upgraded. -->
    <EmbeddedResource Include="Database\Migrations\*.sql" />
  </ItemGroup>
</Project>
