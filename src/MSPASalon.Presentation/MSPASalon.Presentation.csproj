    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MSPASalon.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MSPASalon.Core\MSPASalon.Core.csproj" />
  </ItemGroup>
</Project>
