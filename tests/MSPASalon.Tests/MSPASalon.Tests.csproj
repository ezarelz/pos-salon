<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Automated tests as a self-contained console runner (no xUnit/NUnit package needed).
    Run:  dotnet run (project tests/MSPASalon.Tests)
    Exit code 0 = all tests passed, 1 = at least one failure.
    A results report is written to tests/TestResults/test-results.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MSPASalon.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MSPASalon.Core\MSPASalon.Core.csproj" />
    <ProjectReference Include="..\..\src\MSPASalon.Infrastructure\MSPASalon.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MSPASalon.Presentation\MSPASalon.Presentation.csproj" />
  </ItemGroup>
</Project>
